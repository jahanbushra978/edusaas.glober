{
  "name": "ExamInput",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Title/label for this input (e.g. Question Paper Jan 2026)"
    },
    "session": {
      "type": "string",
      "description": "Which session this belongs to"
    },
    "exam_id": {
      "type": "string",
      "description": "Optional reference to a specific exam"
    },
    "image_url": {
      "type": "string",
      "description": "URL of the uploaded image/file"
    },
    "file_type": {
      "type": "string",
      "enum": [
        "image",
        "document"
      ],
      "default": "image"
    },
    "is_visible": {
      "type": "boolean",
      "default": true,
      "description": "Whether to show on the home page"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "image_url"
  ]
}