{
  "name": "HeroSlide",
  "type": "object",
  "properties": {
    "image_url": {
      "type": "string",
      "description": "URL of the slide image"
    },
    "caption_en": {
      "type": "string",
      "description": "Caption in English"
    },
    "caption_bn": {
      "type": "string",
      "description": "Caption in Bengali"
    },
    "is_active": {
      "type": "boolean",
