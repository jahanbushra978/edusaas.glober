# PostgreSQL connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mosque?schema=public"
# 32+ random characters:  openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-of-32-or-more-chars"
# 16+ random characters. Your scheduler sends it to POST /api/cron/reminders
CRON_SECRET="change-me-too-16-or-more-chars"

